{
  "name": "@mash/ui",
  "version": "0.0.0",
  "description": "Framework-independent Web Components for the mash design system. Canonical artifact is a preserved ES module graph, not a bundle.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "custom-elements.json"
  ],
  "customElements": "custom-elements.json",
  "//sideEffects": [
    "Definition modules are pure: importing `@mash/ui/button` defines no element.",
    "Only `register.js` modules touch the CustomElementRegistry, so only they are",
    "flagged side-effectful. This is what lets a bundler drop unused components."
  ],
  "sideEffects": [
    "./dist/**/register.js",
    "./dist/register.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./avatar": {
      "types": "./dist/avatar/avatar.d.ts",
      "import": "./dist/avatar/avatar.js"
    },
    "./avatar/register": {
      "types": "./dist/avatar/register.d.ts",
      "import": "./dist/avatar/register.js"
    },
    "./badge": {
      "types": "./dist/badge/badge.d.ts",
      "import": "./dist/badge/badge.js"
    },
    "./badge/register": {
      "types": "./dist/badge/register.d.ts",
      "import": "./dist/badge/register.js"
    },
    "./button": {
      "types": "./dist/button/button.d.ts",
      "import": "./dist/button/button.js"
    },
    "./button/register": {
      "types": "./dist/button/register.d.ts",
      "import": "./dist/button/register.js"
    },
    "./card": {
      "types": "./dist/card/card.d.ts",
      "import": "./dist/card/card.js"
    },
    "./card/register": {
      "types": "./dist/card/register.d.ts",
      "import": "./dist/card/register.js"
    },
    "./kbd": {
      "types": "./dist/kbd/kbd.d.ts",
      "import": "./dist/kbd/kbd.js"
    },
    "./kbd/register": {
      "types": "./dist/kbd/register.d.ts",
      "import": "./dist/kbd/register.js"
    },
    "./path": {
      "types": "./dist/path/path.d.ts",
      "import": "./dist/path/path.js"
    },
    "./path/register": {
      "types": "./dist/path/register.d.ts",
      "import": "./dist/path/register.js"
    },
    "./progress": {
      "types": "./dist/progress/progress.d.ts",
      "import": "./dist/progress/progress.js"
    },
    "./progress/register": {
      "types": "./dist/progress/register.d.ts",
      "import": "./dist/progress/register.js"
    },
    "./separator": {
      "types": "./dist/separator/separator.d.ts",
      "import": "./dist/separator/separator.js"
    },
    "./separator/register": {
      "types": "./dist/separator/register.d.ts",
      "import": "./dist/separator/register.js"
    },
    "./spinner": {
      "types": "./dist/spinner/spinner.d.ts",
      "import": "./dist/spinner/spinner.js"
    },
    "./spinner/register": {
      "types": "./dist/spinner/register.d.ts",
      "import": "./dist/spinner/register.js"
    },
    "./tree": {
      "types": "./dist/tree/tree.d.ts",
      "import": "./dist/tree/tree.js"
    },
    "./tree/register": {
      "types": "./dist/tree/register.d.ts",
      "import": "./dist/tree/register.js"
    },
    "./tree-item": {
      "types": "./dist/tree-item/tree-item.d.ts",
      "import": "./dist/tree-item/tree-item.js"
    },
    "./tree-item/register": {
      "types": "./dist/tree-item/register.d.ts",
      "import": "./dist/tree-item/register.js"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:manifest",
    "build:js": "tsc -p tsconfig.build.json",
    "build:manifest": "cem analyze --config custom-elements-manifest.config.mjs",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all-browsers": "BROWSERS=chromium,firefox,webkit vitest run",
    "//dev": "Both watchers are needed: tsc regenerates dist/, cem regenerates the manifest the catalog reads for its API tables.",
    "dev": "concurrently --names tsc,cem --prefix-colors blue,magenta \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"cem analyze --config custom-elements-manifest.config.mjs --watch\"",
    "clean": "rm -rf dist custom-elements.json *.tsbuildinfo"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@mash/tokens": "workspace:*",
    "@types/node": "26.2.0",
    "concurrently": "10.0.5",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
