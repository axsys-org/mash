{
  // The type-checking configuration. Covers everything in the package,
  // including tests and tooling config, and emits nothing.
  // The published output is built by tsconfig.build.json instead.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // Node types are needed here for vitest.config.ts, which reads env vars.
    // tsconfig.build.json deliberately keeps `types: []`, so the component
    // sources are checked against the DOM alone and cannot accidentally
    // depend on a Node global that will not exist in a browser.
    "types": ["node"]
  },
  "include": ["src", "vitest.config.ts"]
}
