{
  "type": {
    "$description": "Theme-independent typography semantics.\n\nAuthored as groups of individual DTCG tokens (fontFamily / fontSize / fontWeight / lineHeight) rather than as composite `typography` tokens. Composite tokens compile either to a lossy CSS `font` shorthand — which silently drops letter-spacing — or to an expanded form that loses the per-field type information. Individual tokens keep every field independently addressable and keep the generated CSS obvious.",

    "body": {
      "$description": "Default running text.",
      "fontFamily": {
        "$type": "fontFamily",
        "$value": "{fontFamily.reference.sans}"
      },
      "fontSize": {
        "$type": "dimension",
        "$value": "{fontSize.reference.300}"
      },
      "fontWeight": {
        "$type": "fontWeight",
        "$value": "{fontWeight.reference.regular}"
      },
      "lineHeight": {
        "$type": "number",
        "$value": "{lineHeight.reference.normal}"
      }
    },

    "label": {
      "$description": "Text inside controls: button labels, form labels, table headers. Slightly heavier and tighter than body so it holds its shape at small sizes.",
      "fontFamily": {
        "$type": "fontFamily",
        "$value": "{fontFamily.reference.sans}"
      },
      "fontSize": {
        "$type": "dimension",
        "$value": "{fontSize.reference.200}"
      },
      "fontWeight": {
        "$type": "fontWeight",
