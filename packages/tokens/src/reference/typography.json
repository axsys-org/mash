{
  "fontFamily": {
    "$type": "fontFamily",
    "reference": {
      "$description": "Font stacks. Authored as DTCG fontFamily arrays; the first entry is the preferred face and the rest are the fallback chain.",
      "sans": {
        "$value": [
          "SF Pro",
          "-apple-system",
          "BlinkMacSystemFont",
          "Segoe UI",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "monospace"
        ]
      }
    }
  },

  "fontSize": {
    "$type": "dimension",
    "reference": {
      "$description": "Type scale, in rem so it respects the user's root font size.",
      "50": {
        "$value": { "value": 0.625, "unit": "rem" },
        "$description": "10px"
      },
      "75": {
        "$value": { "value": 0.6875, "unit": "rem" },
        "$description": "11px"
      },
      "100": {
        "$value": { "value": 0.75, "unit": "rem" },
        "$description": "12px"
      },
      "150": {
        "$value": { "value": 0.8125, "unit": "rem" },
        "$description": "13px"
      },
      "200": {
        "$value": { "value": 0.875, "unit": "rem" },
        "$description": "14px"
      },
      "250": {
        "$value": { "value": 0.9375, "unit": "rem" },
        "$description": "15px"
      },
      "300": {
        "$value": { "value": 1, "unit": "rem" },
        "$description": "16px"
      },
      "350": {
        "$value": { "value": 1.0625, "unit": "rem" },
        "$description": "17px"
      },
      "400": {
        "$value": { "value": 1.125, "unit": "rem" },
        "$description": "18px"
      },
      "500": {
        "$value": { "value": 1.375, "unit": "rem" },
        "$description": "22px"
      },
      "550": {
        "$value": { "value": 1.625, "unit": "rem" },
        "$description": "26px"
      },
      "600": {
        "$value": { "value": 1.75, "unit": "rem" },
        "$description": "28px"
      }
    }
  },

  "fontWeight": {
    "$type": "fontWeight",
    "reference": {
      "$description": "DTCG fontWeight tokens. Numeric so they interpolate predictably on variable fonts.",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    }
  },

  "lineHeight": {
    "$type": "number",
    "reference": {
      "$description": "Unitless line heights, so they multiply against whatever font size inherits.",
      "caption": { "$value": 1.3, "$description": "13px on 10px type." },
      "subheadline": {
        "$value": 1.272727,
        "$description": "14px on 11px type."
      },
      "callout": { "$value": 1.25, "$description": "15px on 12px type." },
      "body": { "$value": 1.230769, "$description": "16px on 13px type." },
      "title3": { "$value": 1.333333, "$description": "20px on 15px type." },
      "title2": { "$value": 1.294118, "$description": "22px on 17px type." },
      "title1": { "$value": 1.181818, "$description": "26px on 22px type." },
      "largeTitle": {
        "$value": 1.230769,
        "$description": "32px on 26px type."
      },
      "tight": { "$value": 1.2 },
      "normal": { "$value": 1.5 },
      "relaxed": { "$value": 1.7 }
    }
  }
}
