{
  "duration": {
    "$type": "duration",
    "reference": {
      "$description": "Motion durations. Kept short: these exist to make state changes legible, not decorative. Every consumer of these tokens must still honour prefers-reduced-motion.",
      "instant": { "$value": { "value": 0, "unit": "ms" } },
      "fast": { "$value": { "value": 120, "unit": "ms" } },
      "normal": { "$value": { "value": 200, "unit": "ms" } },
      "slow": { "$value": { "value": 320, "unit": "ms" } },
      "microEnter": { "$value": { "value": 80, "unit": "ms" } },
      "microExit": { "$value": { "value": 60, "unit": "ms" } },
      "compactEnter": { "$value": { "value": 160, "unit": "ms" } },
      "surfaceEnter": { "$value": { "value": 240, "unit": "ms" } }
    }
  },

  "easing": {
    "$type": "cubicBezier",
    "reference": {
      "$description": "DTCG cubicBezier tokens, expressed as [x1, y1, x2, y2] control points.",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "emphasized": { "$value": [0.3, 0, 0, 1] },
      "linear": { "$value": [0, 0, 1, 1] },
      "settle": { "$value": [0.22, 1, 0.36, 1] },
      "spring": { "$value": [0.22, 1.15, 0.36, 1] }
    }
  },

  "motionDistance": {
    "$type": "dimension",
    "$description": "Raw spatial motion offsets. Consumers use motion.distance semantic aliases.",
    "reference": {
      "short": { "$value": { "value": 0.25, "unit": "rem" } },
      "medium": { "$value": { "value": 0.75, "unit": "rem" } },
      "long": { "$value": { "value": 1.5, "unit": "rem" } }
    }
  },
  "motionScale": {
    "$type": "number",
    "reference": {
      "rest": { "$value": 1 },
      "contracted": { "$value": 0.96 },
      "pressed": { "$value": 0.98 },
      "expanded": { "$value": 1.04 }
    }
  },
  "motionBlur": {
    "$type": "dimension",
    "reference": {
      "none": { "$value": { "value": 0, "unit": "px" } },
      "subtle": { "$value": { "value": 4, "unit": "px" } },
      "emphasized": { "$value": { "value": 12, "unit": "px" } }
    }
  },
  "motionOpacity": {
    "$type": "number",
    "reference": {
      "hidden": { "$value": 0 },
      "muted": { "$value": 0.56 },
      "visible": { "$value": 1 }
    }
  },
  "motionRotation": {
    "$type": "number",
    "reference": {
      "none": { "$value": 0 },
      "quarter": { "$value": 0.25 },
      "full": { "$value": 1 }
    }
  }
}
