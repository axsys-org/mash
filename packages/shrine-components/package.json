{
  "name": "@mash/shrine",
  "version": "0.0.0",
  "description": "Higher-level composed components built on @mash/ui. Same architecture: a preserved ES module graph, not a bundle.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "custom-elements.json"
  ],
  "customElements": "custom-elements.json",
  "//sideEffects": [
    "Same contract as @mash/ui: definition modules are pure, only register.js",
    "modules touch the CustomElementRegistry. A shrine register module also",
    "registers the @mash/ui elements it composes, so importing it is enough."
  ],
  "sideEffects": [
    "./dist/**/register.js",
    "./dist/register.js",
    "./dist/tailwind.css",
    "./src/catalogue/mash.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./catalogue/mash.css": "./src/catalogue/mash.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./confirm": {
      "types": "./dist/confirm/confirm.d.ts",
      "import": "./dist/confirm/confirm.js"
    },
    "./triptych": {
      "types": "./dist/triptych/triptych.d.ts",
      "import": "./dist/triptych/triptych.js"
    },
    "./triptych/register": {
      "types": "./dist/triptych/register.d.ts",
      "import": "./dist/triptych/register.js"
    },
    "./confirm/register": {
      "types": "./dist/confirm/register.d.ts",
      "import": "./dist/confirm/register.js"
    },
    "./locator": {
      "types": "./dist/locator/locator.d.ts",
      "import": "./dist/locator/locator.js"
    },
    "./locator/register": {
      "types": "./dist/locator/register.d.ts",
      "import": "./dist/locator/register.js"
    },
    "./myth": {
      "types": "./dist/myth/myth.d.ts",
      "import": "./dist/myth/myth.js"
    },
    "./myth/register": {
      "types": "./dist/myth/register.d.ts",
      "import": "./dist/myth/register.js"
    },
    "./limb": {
      "types": "./dist/limb/limb.d.ts",
      "import": "./dist/limb/limb.js"
    },
    "./limb/register": {
      "types": "./dist/limb/register.d.ts",
      "import": "./dist/limb/register.js"
    },
    "./slot": {
      "types": "./dist/slot/slot.d.ts",
      "import": "./dist/slot/slot.js"
    },
    "./slot/register": {
      "types": "./dist/slot/register.d.ts",
      "import": "./dist/slot/register.js"
    },
    "./pail": {
      "types": "./dist/pail/pail.d.ts",
      "import": "./dist/pail/pail.js"
    },
    "./pail/register": {
      "types": "./dist/pail/register.d.ts",
      "import": "./dist/pail/register.js"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:manifest",
    "build:js": "tsc -p tsconfig.build.json",
    "build:manifest": "cem analyze --config custom-elements-manifest.config.mjs && pnpm run build:tailwind",
    "build:tailwind": "node ../../scripts/build-tailwind-components.mjs",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "//dev": "Both watchers are needed: tsc regenerates dist/, cem regenerates the manifest the catalog reads for its API tables.",
    "dev": "concurrently --names tsc,cem --prefix-colors green,magenta \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"cem analyze --config custom-elements-manifest.config.mjs --watch\"",
    "clean": "rm -rf dist custom-elements.json *.tsbuildinfo"
  },
  "dependencies": {
    "@mash/ui": "workspace:*",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@mash/tokens": "workspace:*",
    "@types/node": "26.2.0",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "concurrently": "10.0.5",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
