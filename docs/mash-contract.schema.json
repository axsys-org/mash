{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mash.local/schemas/semantic-contract-v1.json",
  "title": "Mash semantic contract extension",
  "description": "The declaration.mash extension emitted in a Custom Elements Manifest.",
  "type": "object",
  "required": ["schemaVersion", "nodes", "bindings", "axes"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "role": { "$ref": "#/$defs/identifier" },
          "parent": { "$ref": "#/$defs/identifier" }
        },
        "additionalProperties": false
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "name", "role", "node"],
        "properties": {
          "kind": {
            "enum": ["attribute", "event", "part", "slot", "state"]
          },
          "name": { "type": "string", "minLength": 1 },
          "role": { "$ref": "#/$defs/identifier" },
          "node": { "$ref": "#/$defs/identifier" }
        },
        "additionalProperties": false
      }
    },
    "axes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node", "kind"],
        "properties": {
          "node": { "$ref": "#/$defs/identifier" },
          "kind": {
            "enum": [
              "control-size",
              "density",
              "glyph-size",
              "identity-size",
              "indicator-size",
              "layout-size",
              "scrollbar-size",
              "type-preset"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    }
  },
  "additionalProperties": false
}
