{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mash.axsys.dev/schema/conformance-surface-tree-1.0.0.json",
  "title": "Mash cross-renderer SurfaceTree fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "componentContract", "components"],
  "properties": {
    "$schema": {
      "const": "https://mash.axsys.dev/schema/conformance-surface-tree-1.0.0.json"
    },
    "version": { "const": "1.0.0" },
    "componentContract": { "const": "1.0.0" },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tag", "package", "address", "root", "nodes", "events"],
        "properties": {
          "tag": { "type": "string", "pattern": "^(ui|sh)-|^shrine-" },
          "package": { "enum": ["ui", "shrine"] },
          "address": { "type": "string", "pattern": "^mash://" },
          "root": { "type": "string", "pattern": "^mash://" },
          "nodes": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/node" }
          },
          "events": {
            "type": "array",
            "items": { "$ref": "#/$defs/event" }
          }
        }
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "address",
        "role",
        "family",
        "ownership",
        "values",
        "defaults",
        "fallbacks",
        "channels",
        "availability"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "address": { "type": "string", "pattern": "^mash://" },
        "role": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "ownership": {
          "enum": ["authored", "controlled", "reported", "realized"]
        },
        "parent": { "type": "string", "pattern": "^mash://" },
        "values": { "type": "array", "items": { "type": "object" } },
        "defaults": { "type": "array", "items": { "type": "object" } },
        "fallbacks": { "type": "array", "items": { "type": "object" } },
        "channels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["content", "input", "output", "realization", "state"]
          }
        },
        "availability": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeAddress", "role", "intent", "relations", "value"],
      "properties": {
        "nodeAddress": { "type": "string", "pattern": "^mash://" },
        "role": { "type": "string", "minLength": 1 },
        "intent": { "enum": ["request", "report"] },
        "relations": { "type": "array", "items": { "type": "object" } },
        "value": { "type": "object" }
      }
    }
  }
}
