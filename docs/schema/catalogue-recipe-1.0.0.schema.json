{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mash.axsys.dev/schema/catalogue-recipe-1.0.0.json",
  "title": "Mash catalogue recipe",
  "type": "object",
  "required": [
    "$schema",
    "version",
    "name",
    "componentContract",
    "layoutContract",
    "layoutVocabulary",
    "presentationContract",
    "presentationVocabulary",
    "nodes",
    "rules"
  ],
  "properties": {
    "$schema": {
      "const": "https://mash.axsys.dev/schema/catalogue-recipe-1.0.0.json"
    },
    "version": { "const": "1.0.0" },
    "name": { "type": "string", "minLength": 1 },
    "componentContract": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "layoutContract": { "const": "1.1.0" },
    "layoutVocabulary": {
      "type": "object",
      "required": [
        "axes",
        "groups",
        "alignments",
        "distributions",
        "overflow",
        "positions",
        "dimensions",
        "edges"
      ],
      "additionalProperties": false,
      "properties": {
        "axes": {
          "type": "array",
          "items": { "enum": ["block", "inline", "depth"] }
        },
        "groups": {
          "type": "array",
          "items": { "enum": ["none", "contents", "flow", "grid", "overlay"] }
        },
        "alignments": {
          "type": "array",
          "items": {
            "enum": ["leading", "center", "trailing", "stretch", "baseline"]
          }
        },
        "distributions": {
          "type": "array",
          "items": {
            "enum": [
              "leading",
              "center",
              "trailing",
              "between",
              "around",
              "evenly",
              "stretch"
            ]
          }
        },
        "overflow": {
          "type": "array",
          "items": { "enum": ["visible", "clip", "hidden", "auto", "scroll"] }
        },
        "positions": {
          "type": "array",
          "items": {
            "enum": ["flow", "relative", "absolute", "fixed", "sticky"]
          }
        },
        "dimensions": {
          "type": "array",
          "items": { "enum": ["min", "preferred", "max"] }
        },
        "edges": {
          "type": "array",
          "items": {
            "enum": ["blockStart", "blockEnd", "inlineStart", "inlineEnd"]
          }
        }
      }
    },
    "presentationContract": { "const": "1.0.0" },
    "presentationVocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspects",
        "eventIntents",
        "relationKinds",
        "conditionKinds"
      ],
      "properties": {
        "aspects": {
          "type": "array",
          "items": {
            "enum": [
              "surface",
              "content",
              "edge",
              "focus",
              "elevation",
              "type",
              "motion",
              "interaction",
              "media",
              "generated",
              "layout"
            ]
          }
        },
        "eventIntents": {
          "type": "array",
          "items": { "enum": ["request", "report"] }
        },
        "relationKinds": {
          "type": "array",
          "items": { "enum": ["requests", "reports"] }
        },
        "conditionKinds": {
          "type": "array",
          "items": {
            "enum": [
              "node",
              "interaction",
              "environment",
              "context",
              "renderer"
            ]
          }
        }
      }
    },
    "source": { "type": "string" },
    "nodes": {
      "type": "object",
      "propertyNames": { "pattern": "^mash://" },
      "additionalProperties": {
        "type": "object",
        "required": ["tokens", "coverage", "layout"],
        "properties": {
          "tokens": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "coverage": { "enum": ["direct", "contract-only"] },
          "layout": { "enum": ["constrained", "unconstrained"] }
        },
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["targets", "when", "presentation", "declarations"],
        "properties": {
          "targets": {
            "type": "array",
            "items": { "type": "string", "pattern": "^mash://" },
            "minItems": 1,
            "uniqueItems": true
          },
          "when": {
            "type": "object",
            "required": ["conditions", "web"],
            "properties": {
              "conditions": {
                "type": "array",
                "items": { "$ref": "#/$defs/condition" }
              },
              "web": {
                "type": "object",
                "required": ["selector", "context"],
                "additionalProperties": false,
                "properties": {
                  "selector": { "type": "string" },
                  "context": { "type": "array", "items": { "type": "string" } }
                }
              }
            },
            "additionalProperties": false
          },
          "presentation": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z][a-zA-Z]*(?:\\.[a-z][a-zA-Z]*)+$"
            },
            "additionalProperties": { "$ref": "#/$defs/presentationValue" }
          },
          "parameters": {
            "type": "object",
            "propertyNames": { "pattern": "^--_" },
            "additionalProperties": { "$ref": "#/$defs/recipeValue" }
          },
          "declarations": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/recipeValue" }
          },
          "layout": {
            "$ref": "#/$defs/layout"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "recipeValue": {
      "type": "object",
      "required": ["value", "tokens"],
      "properties": {
        "value": { "type": "string" },
        "tokens": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "presentationValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceProperty", "kind", "value", "tokens"],
      "properties": {
        "sourceProperty": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["token", "literal", "expression"] },
        "value": { "type": "string" },
        "tokens": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "token": { "type": "string", "minLength": 1 }
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "nodeAddress", "operator"],
          "properties": {
            "kind": { "const": "node" },
            "nodeAddress": { "type": "string", "pattern": "^mash://" },
            "operator": {
              "enum": [
                "truthy",
                "falsy",
                "equals",
                "starts-with",
                "ends-with",
                "contains"
              ]
            },
            "value": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "state", "active"],
          "properties": {
            "kind": { "const": "interaction" },
            "state": { "type": "string" },
            "active": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "feature", "value"],
          "properties": {
            "kind": { "const": "environment" },
            "feature": { "type": "string" },
            "value": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "operator"],
          "properties": {
            "kind": { "const": "context" },
            "name": { "type": "string" },
            "operator": { "type": "string" },
            "value": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "renderer", "selector"],
          "properties": {
            "kind": { "const": "renderer" },
            "renderer": { "const": "web" },
            "selector": { "type": "string" }
          }
        }
      ]
    },
    "measure": {
      "type": "object",
      "required": ["value", "tokens"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "tokens": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "axisDimensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": { "$ref": "#/$defs/measure" },
        "preferred": { "$ref": "#/$defs/measure" },
        "max": { "$ref": "#/$defs/measure" }
      }
    },
    "layout": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "group": {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["none", "contents", "flow", "grid", "overlay"] },
            "axis": { "enum": ["block", "inline", "depth"] },
            "reverse": { "type": "boolean" },
            "wrap": { "type": "boolean" }
          }
        },
        "align": {
          "enum": ["leading", "center", "trailing", "stretch", "baseline"]
        },
        "justify": {
          "enum": [
            "leading",
            "center",
            "trailing",
            "between",
            "around",
            "evenly",
            "stretch"
          ]
        },
        "gap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inline": { "$ref": "#/$defs/measure" },
            "block": { "$ref": "#/$defs/measure" }
          }
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inline": { "$ref": "#/$defs/axisDimensions" },
            "block": { "$ref": "#/$defs/axisDimensions" }
          }
        },
        "inset": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "blockStart": { "$ref": "#/$defs/measure" },
            "blockEnd": { "$ref": "#/$defs/measure" },
            "inlineStart": { "$ref": "#/$defs/measure" },
            "inlineEnd": { "$ref": "#/$defs/measure" }
          }
        },
        "margin": {
          "$ref": "#/$defs/edges"
        },
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "blockStart": { "$ref": "#/$defs/measure" },
            "blockEnd": { "$ref": "#/$defs/measure" },
            "inlineStart": { "$ref": "#/$defs/measure" },
            "inlineEnd": { "$ref": "#/$defs/measure" },
            "layer": { "$ref": "#/$defs/measure" }
          }
        },
        "self": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "align": {
              "enum": ["leading", "center", "trailing", "stretch", "baseline"]
            },
            "justify": {
              "enum": [
                "leading",
                "center",
                "trailing",
                "between",
                "around",
                "evenly",
                "stretch"
              ]
            },
            "grow": { "type": "string" },
            "shrink": { "type": "string" },
            "basis": { "$ref": "#/$defs/measure" },
            "gridRow": { "type": "string" },
            "gridColumn": { "type": "string" }
          }
        },
        "grid": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "columns": { "$ref": "#/$defs/measure" },
            "rows": { "$ref": "#/$defs/measure" },
            "autoFlow": { "type": "string" }
          }
        },
        "aspectRatio": { "type": "string" },
        "overflow": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inline": {
              "enum": ["visible", "clip", "hidden", "auto", "scroll"]
            },
            "block": { "enum": ["visible", "clip", "hidden", "auto", "scroll"] }
          }
        },
        "position": {
          "enum": ["flow", "relative", "absolute", "fixed", "sticky"]
        }
      }
    },
    "edges": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blockStart": { "$ref": "#/$defs/measure" },
        "blockEnd": { "$ref": "#/$defs/measure" },
        "inlineStart": { "$ref": "#/$defs/measure" },
        "inlineEnd": { "$ref": "#/$defs/measure" }
      }
    }
  },
  "additionalProperties": false
}
